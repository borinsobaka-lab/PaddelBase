# --- Supabase (PostgreSQL) ---
# Пулер транзакций, порт 6543. Флаг pgbouncer=true обязателен: без него Prisma
# ломается на prepared statements. connection_limit=1 — на инстанс приложения.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Прямое соединение, порт 5432. Используется только миграциями Prisma.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Supabase Storage ---
SUPABASE_URL="https://PROJECT_REF.supabase.co"
# Только на сервере. В браузер не отдавать ни при каких условиях.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="media"
# Локальный прогон production-сборки без Supabase: файлы лягут на диск и
# не переживут перезапуск контейнера. Только для разработки.
# MEDIA_STORAGE="local"

# --- Telegram ---
TELEGRAM_BOT_TOKEN=""
# Секрет для подписи собственной сессии (httpOnly cookie).
SESSION_SECRET=""

# --- Приложение ---
APP_TIMEZONE="Asia/Tbilisi"
