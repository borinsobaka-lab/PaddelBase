# Контекст сборки. Без этого файла `COPY . .` в build-стадии затирает
# node_modules, установленные в deps-стадии, теми, что лежат на машине сборки:
# бинарники Prisma и esbuild собраны под другую платформу, и падает это не на
# COPY, а сильно позже и невнятно.

node_modules
**/node_modules

.next
**/.next
dist
**/dist

.git
.gitignore
.github

# Локальные переменные окружения не должны попадать в образ ни при каких
# обстоятельствах: в Coolify они приходят из его собственных настроек.
.env
.env.*
!.env.example

*.log
.DS_Store

# Тесты, документация и снимки в рантайме не нужны и только раздувают контекст.
**/*.test.ts
**/*.test.tsx
docs
DESIGN.md
README.md
